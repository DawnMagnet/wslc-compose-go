wslc network create --subnet 172.28.1.0/24 --gateway 172.28.1.1 --ip-range 172.28.1.128/25 --internal -o com.docker.network.bridge.name=br-back -l com.docker.compose.network=back -l com.docker.compose.project=nets nets_back
wslc network create --subnet 172.28.0.0/24 --gateway 172.28.0.1 -l com.docker.compose.network=front -l com.docker.compose.project=nets nets_front
wslc create --name nets-app-1 -l com.docker.compose.container-number=1 -l com.docker.compose.oneoff=False -l com.docker.compose.project=nets -l com.docker.compose.project.config_files=C:/proj/networks.yaml -l com.docker.compose.project.working_dir=C:/proj -l com.docker.compose.service=app -l com.wslc.compose.config-hash=<hash> -l com.wslc.compose.version=dev --network nets_back --ip 172.28.1.10 --network-alias app --network-alias db --dns 1.1.1.1 alpine
wslc network connect --ip 172.28.0.10 --link-local-ip 169.254.1.10 --driver-opt com.docker.network.endpoint.foo=bar --network-alias app --network-alias www nets_front nets-app-1
wslc start nets-app-1
wslc run -d --name nets-edge-1 -l com.docker.compose.container-number=1 -l com.docker.compose.oneoff=False -l com.docker.compose.project=nets -l com.docker.compose.project.config_files=C:/proj/networks.yaml -l com.docker.compose.project.working_dir=C:/proj -l com.docker.compose.service=edge -l com.wslc.compose.config-hash=<hash> -l com.wslc.compose.version=dev --network already --network-alias edge --dns 1.1.1.1 alpine
