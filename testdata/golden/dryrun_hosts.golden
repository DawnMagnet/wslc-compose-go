wslc network create -l com.docker.compose.network=default -l com.docker.compose.project=hosts hosts_default
wslc run -d --name hosts-db-1 -l com.docker.compose.container-number=1 -l com.docker.compose.oneoff=False -l com.docker.compose.project=hosts -l com.docker.compose.project.config_files=C:/proj/hosts.yaml -l com.docker.compose.project.working_dir=C:/proj -l com.docker.compose.service=db -l com.wslc.compose.config-hash=<hash> -l com.wslc.compose.version=dev --network hosts_default --network-alias db --dns 1.1.1.1 alpine
wslc run -d --name hosts-web-1 -l com.docker.compose.container-number=1 -l com.docker.compose.oneoff=False -l com.docker.compose.project=hosts -l com.docker.compose.project.config_files=C:/proj/hosts.yaml -l com.docker.compose.project.working_dir=C:/proj -l com.docker.compose.service=web -l com.wslc.compose.config-hash=<hash> -l com.wslc.compose.host-gateway=v1 -l com.wslc.compose.version=dev -p 8080:80 --network hosts_default --network-alias web --dns 1.1.1.1 alpine
wslc exec -u 0 hosts-web-1 sh -c "set -eu\nGW=$(awk '$2 == \"00000000\" { h=$3; for (i=7; i>=1; i-=2) { hi=index(\"0123456789ABCDEF\", substr(h,i,1))-1; lo=index(\"0123456789ABCDEF\", substr(h,i+1,1))-1; printf \"%s%d\", (i==7 ? \"\" : \".\"), hi*16+lo } print \"\"; exit }' /proc/net/route 2>/dev/null || true)\nif [ -z \"$GW\" ]; then echo 'wslc-compose: host-gateway address not found' >&2; exit 1; fi\ntmp=$(mktemp)\ngrep -v 'wslc-compose-extra-host' /etc/hosts > \"$tmp\" || true\ncat \"$tmp\" > /etc/hosts\nrm -f \"$tmp\"\nprintf '%s db.internal # wslc-compose-extra-host\\n' '10.1.2.3' >> /etc/hosts\nprintf '%s host.docker.internal # wslc-compose-extra-host\\n' \"$GW\" >> /etc/hosts\n"
