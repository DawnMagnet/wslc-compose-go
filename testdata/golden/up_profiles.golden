wslc network create -l com.docker.compose.network=default -l com.docker.compose.project=profiles profiles_default
wslc build -t profiles-app -f C:/proj/app/Dockerfile C:/proj/app
wslc run -d --name profiles-migrate-1 -l com.docker.compose.container-number=1 -l com.docker.compose.oneoff=False -l com.docker.compose.project=profiles -l com.docker.compose.project.config_files=C:/proj/profiles.yaml -l com.docker.compose.project.working_dir=C:/proj -l com.docker.compose.service=migrate -l com.wslc.compose.config-hash=<hash> -l com.wslc.compose.version=dev --network profiles_default --network-alias migrate --dns 1.1.1.1 busybox echo migrated
wslc run -d --name profiles-app-1 -l com.docker.compose.container-number=1 -l com.docker.compose.oneoff=False -l com.docker.compose.project=profiles -l com.docker.compose.project.config_files=C:/proj/profiles.yaml -l com.docker.compose.project.working_dir=C:/proj -l com.docker.compose.service=app -l com.wslc.compose.config-hash=<hash> -l com.wslc.compose.version=dev --network profiles_default --network-alias app --dns 1.1.1.1 profiles-app
