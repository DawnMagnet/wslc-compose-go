wslc network create --subnet 172.30.0.0/24 --gateway 172.30.0.1 --internal -l com.docker.compose.network=back -l com.docker.compose.project=full full_back
wslc network create -l com.docker.compose.network=front -l com.docker.compose.project=full full_front
wslc volume create full_cache
wslc volume create shared-dbdata
wslc pull example/api:1.0
wslc pull postgres:16-alpine
wslc build -t example/web:dev -f C:/proj/web/Dockerfile.dev --build-arg VERSION=1.2 --target runtime -l org.example.stage=dev C:/proj/web
wslc run -d --name full-db-1 -l com.docker.compose.container-number=1 -l com.docker.compose.oneoff=False -l com.docker.compose.project=full -l com.docker.compose.project.config_files=C:/proj/full.yaml -l com.docker.compose.project.working_dir=C:/proj -l com.docker.compose.service=db -l com.wslc.compose.config-hash=<hash> -l com.wslc.compose.version=dev -e POSTGRES_PASSWORD=secret -v shared-dbdata:/var/lib/postgresql/data --network full_back --network-alias db --dns 1.1.1.1 --no-healthcheck postgres:16-alpine
wslc run -d --name full-api-1 -l com.docker.compose.container-number=1 -l com.docker.compose.oneoff=False -l com.docker.compose.project=full -l com.docker.compose.project.config_files=C:/proj/full.yaml -l com.docker.compose.project.working_dir=C:/proj -l com.docker.compose.service=api -l com.wslc.compose.config-hash=<hash> -l com.wslc.compose.version=dev -e API_KEY=from-env-file --network full_back --network-alias api --dns 1.1.1.1 -m 1G --cpus 0.5 --gpus all --health-cmd "curl -f http://localhost:8080/ || exit 1" example/api:1.0
wslc run -d --name full-api-2 -l com.docker.compose.container-number=2 -l com.docker.compose.oneoff=False -l com.docker.compose.project=full -l com.docker.compose.project.config_files=C:/proj/full.yaml -l com.docker.compose.project.working_dir=C:/proj -l com.docker.compose.service=api -l com.wslc.compose.config-hash=<hash> -l com.wslc.compose.version=dev -e API_KEY=from-env-file --network full_back --network-alias api --dns 1.1.1.1 -m 1G --cpus 0.5 --gpus all --health-cmd "curl -f http://localhost:8080/ || exit 1" example/api:1.0
wslc run -d --name full-web -l com.docker.compose.container-number=1 -l com.docker.compose.oneoff=False -l com.docker.compose.project=full -l com.docker.compose.project.config_files=C:/proj/full.yaml -l com.docker.compose.project.working_dir=C:/proj -l com.docker.compose.service=web -l com.example.tier=frontend -l com.wslc.compose.config-hash=<hash> -l com.wslc.compose.version=dev -e API_URL=http://api:8080 -e NODE_ENV=production -p 8080:80 -p 127.0.0.1:9443:443/udp -p 3000 -v C:/proj/app:/srv/app:ro -v full_cache:/var/cache/web -v /scratch --tmpfs /run/tmp:size=67108864 --tmpfs /tmp --network full_front --network-alias site --network-alias web --network-alias www -h web01 --domainname example.test --dns 8.8.8.8 --dns-search example.test --dns-option ndots:2 -u 1000:1000 -w /srv/app -m 512M --cpus 1.5 --shm-size 64M --ulimit nofile=1024:2048 --ulimit nproc=512 --stop-signal SIGINT --stop-timeout 20 --health-cmd "curl -f 'http://localhost/health check'" --health-interval 10s --health-timeout 3s --health-start-period 30s --health-retries 5 -i -t --entrypoint /sbin/tini example/web:dev -- npm run start
