wslc network create -l com.docker.compose.network=default -l com.docker.compose.project=sec sec_default
wslc build -t alpine -f C:/proj/web/Dockerfile --secret id=tok,src=C:/proj/api.env C:/proj/web
wslc pull busybox
wslc run -d --name sec-app-1 -l com.docker.compose.container-number=1 -l com.docker.compose.oneoff=False -l com.docker.compose.project=sec -l com.docker.compose.project.config_files=C:/proj/secrets.yaml -l com.docker.compose.project.working_dir=C:/proj -l com.docker.compose.service=app -l com.wslc.compose.config-hash=<hash> -l com.wslc.compose.version=dev -v C:/proj/api.env:/run/secrets/token:ro -v C:/state/sec/secrets/api_key:/run/secrets/api_key:ro -v C:/proj/api.env:/etc/app/config.yml:ro -v C:/state/sec/configs/inline:/inline.cfg:ro --network sec_default --network-alias app --dns 1.1.1.1 alpine
wslc run -d --name sec-ext-1 -l com.docker.compose.container-number=1 -l com.docker.compose.oneoff=False -l com.docker.compose.project=sec -l com.docker.compose.project.config_files=C:/proj/secrets.yaml -l com.docker.compose.project.working_dir=C:/proj -l com.docker.compose.service=ext -l com.wslc.compose.config-hash=<hash> -l com.wslc.compose.version=dev --network sec_default --network-alias ext --dns 1.1.1.1 busybox
